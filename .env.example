# Browser-visible development settings only.
# Copy to .env and fill with a NON-PRODUCTION Supabase project.
# Never put SUPABASE_SERVICE_ROLE_KEY or other server secrets in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional server-side fallbacks used by SSR when the VITE_ values above are absent.
# Keep these on the server environment only; do not prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: isolated local PostgreSQL 17 test database only.
# Do not point test scripts at production or shared customer data.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/aghbari_test
