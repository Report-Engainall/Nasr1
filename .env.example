# Bolt Database connection values are supplied by the active Bolt project.
# VITE_ values are public in the browser. Never put a service-role key or secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for Bolt projects exposing the public key as ANON_KEY.
VITE_SUPABASE_ANON_KEY=

# Server-only values used by SSR/auth middleware. Store actual values in Bolt Secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Optional: isolated local PostgreSQL 17 test database only.
# Never point test scripts at production or shared customer data.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/aghbari_test
