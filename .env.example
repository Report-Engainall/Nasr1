# Independent Supabase project used by Nasr1 (not Bolt Database).
# VITE_ values are public in the browser. Never put a service-role key or secret here.
VITE_SUPABASE_URL=https://tfdwtuwkdddnzgyhcoyy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibility alias for hosts exposing the public key as ANON_KEY.
VITE_SUPABASE_ANON_KEY=

# Server-only values used by SSR/auth middleware. Store actual values in host secrets.
SUPABASE_URL=https://tfdwtuwkdddnzgyhcoyy.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Optional trusted server operations only. Never prefix this key with VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# One-time first-admin Edge Function only. Configure a generated high-entropy value (at least 32 characters)
# in Supabase Edge Function secrets; do not commit a real value or add a VITE_ alias.
NASR1_BOOTSTRAP_SECRET=

# Optional: isolated local PostgreSQL 17 test database only.
# Never point test scripts at production or shared customer data.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/aghbari_test
